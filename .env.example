# 이 파일을 .env로 복사해서 값을 채우세요. 실제 값은 커밋 금지.

# --- Backend ---
# 이 줄을 지우면 backend/local.db를 쓴다. 상대 경로(sqlite:///./x.db)는 서버·CLI를 실행한 위치(cwd) 기준이다.
DATABASE_URL=sqlite:///./local.db
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_API_URL=https://clovastudio.stream.ntruss.com

# NCP Object Storage
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET_NAME=
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com

# Instagram (Unified login). APP_ID/SECRET은 Meta 앱 값(앱 설정 → 기본 설정)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 연동 링크(connect-url)를 쓸 때만 필요. 콘솔 토큰 등록(register-instagram)만 쓰면 비워 둬도 된다.
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=
STATE_SECRET=
OAUTH_STATE_MAX_AGE=259200
ADMIN_TOKEN=
MEDIA_STORAGE=local
# 이 줄을 지우면 <저장소>/data/raw/media를 쓴다. 상대 경로는 서버·CLI를 실행한 위치(cwd) 기준이다.
MEDIA_LOCAL_DIR=../data/raw/media

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
